{
  "expo": {
    "name": "Bookit",
    "slug": "bookit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bookit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5F0EB",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.bookit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F0EB"
      },
      "package": "com.yourname.bookit"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
